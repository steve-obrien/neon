{
	"name": "newicon/neon",
	"description": "Neon framework",
	"license": "MIT",
	"authors": [
		{
			"name": "Steven O'Brien",
			"email": "steve@newicon.net"
		}
	],
	"require": {
		"php": ">=8.1",
		"ext-json": "*",
		"ext-mbstring": "*",
		"ext-openssl": "*",
		"ext-pdo": "*",
		"fakerphp/faker": "^1.23",
		"firebase/php-jwt": "*",
		"guzzlehttp/guzzle": ">=4.1.4 <7.9.2",
		"intervention/image": "^2.3",
		"league/flysystem": "3.*",
		"nesbot/carbon": "^2.0.0",
		"smarty/smarty": "4.5.0",
		"symfony/process": "*",
		"symfony/var-dumper": "4.*",
		"yiisoft/yii2": "^2.0.47",
		"yiisoft/yii2-bootstrap": "2.*",
		"yiisoft/yii2-debug": "2.*",
		"yiisoft/yii2-smarty": "2.*",
		"yiisoft/yii2-symfonymailer": "^4.0"
	},
	"require-dev": {
		"codeception/codeception": "*",
		"codeception/module-asserts": "*",
		"codeception/module-rest": "*",
		"codeception/module-webdriver": "*",
		"phpunit/phpunit": "*",
		"psy/psysh": "*"
	},
	"autoload": {
		"files": [
			"neon/core/helpers.php"
		],
		"psr-4": {
			"neon\\": "neon/"
		}
	},
	"config": {
		"allow-plugins": {
			"yiisoft/yii2-composer": true
		},
		"fxp-asset": {
			"enabled": false
		},
		"process-timeout": 1800,
		"sort-packages": true,
		"optimize-autoloader": true
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://asset-packagist.org"
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true
}