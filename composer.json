{
	"name": "newicon/neon",
	"description": "Neon framework",
	"license": "MIT",
	"authors": [
		{
			"name": "Steven O'Brien",
			"email": "steve@newicon.net"
		}
	],
	"require": {
		"php": "^8.3",
		"ext-json": "*",
		"ext-mbstring": "*",
		"ext-openssl": "*",
		"ext-pdo": "*",
		"ext-fileinfo": "*",
		"fakerphp/faker": "^1.23",
		"firebase/php-jwt": "^6.10",
		"guzzlehttp/guzzle": "^7.8",
		"intervention/image": "^2.7",
		"league/flysystem": "^3.0",
		"nesbot/carbon": "^2.0",
		"smarty/smarty": "^4.5",
		"symfony/process": "^6.4 || ^7.0",
		"symfony/var-dumper": "^6.4 || ^7.0",
		"yiisoft/yii2": "^2.0.47",
		"yiisoft/yii2-bootstrap": "^2.0.11",
		"yiisoft/yii2-debug": "^2.1",
		"yiisoft/yii2-smarty": "2.*",
		"yiisoft/yii2-symfonymailer": "^4.0"
	},
	"require-dev": {
		"codeception/codeception": "^5.3",
		"codeception/module-asserts": "^3.3",
		"codeception/module-rest": "^3.4",
		"codeception/module-webdriver": "^4.0",
		"phpunit/phpunit": "^10.5 || ^11.0",
		"psy/psysh": "^0.12"
	},
	"autoload": {
		"files": [
			"neon/core/helpers.php"
		],
		"psr-4": {
			"neon\\": "neon/"
		}
	},
	"config": {
		"allow-plugins": {
			"yiisoft/yii2-composer": true
		},
		"fxp-asset": {
			"enabled": false
		},
		"process-timeout": 1800,
		"sort-packages": true,
		"optimize-autoloader": true
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://asset-packagist.org"
		}
	],
	"minimum-stability": "dev",
	"prefer-stable": true
}